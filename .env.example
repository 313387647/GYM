# 必填：不要把真实 Key 提交到 Git
MIMO_API_KEY=
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_TEXT_MODEL=mimo-v2.5
MIMO_VISION_MODEL=mimo-v2.5
MIMO_TIMEOUT_MS=60000
MIMO_MAX_RETRIES=2

# 用户时间；服务器使用 UTC 也不会改变逻辑日期
USER_TIMEZONE=Asia/Shanghai
LOGICAL_DAY_CUTOFF_HOUR=6

# Docker 中设置为 /app/data/gym_coach.db；本地为空时兼容根目录旧数据库
GYM_DB_PATH=
GYM_DATA_DIR=
GYM_USER_ID=primary-user

# wechat-acp inbox 必须限制在明确目录
WECHAT_INBOX_DIR=
WECHAT_ALLOWED_INBOX_ROOTS=
WECHAT_ACP_INSTANCE=gym
WECHAT_INJECT_ENABLED=false
WECHAT_ACP_TELEMETRY=0

SCHEDULER_POLL_INTERVAL_MS=60000
SCHEDULER_ENABLED=true
PORT=3000
