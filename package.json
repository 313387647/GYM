{
  "name": "gym-coach",
  "version": "2.0.0",
  "private": true,
  "description": "A stateful MiMo-powered personal health and fitness life agent for WeChat.",
  "main": "src/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "lint": "node scripts/lint.js",
    "migrate": "node src/db/migrate.js",
    "backup": "node scripts/backup.js",
    "scheduler": "node src/scheduler/scheduler.js",
    "acp": "node src/acp/server.mjs",
    "mimo:text": "node scripts/test-mimo.js text",
    "mimo:vision": "node scripts/test-mimo.js vision"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.0.0"
  }
}
